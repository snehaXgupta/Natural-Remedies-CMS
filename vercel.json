{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://natural-remedies-cms.onrender.com/api/:path*"
    },
    {
      "source": "/externalsource1/:path*",
      "destination": "https://natural-remedies-cms.onrender.com/externalsource1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
